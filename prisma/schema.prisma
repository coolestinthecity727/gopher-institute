// Gopher Institute Foundation — database schema
// SQLite by default for easy local setup. Point DATABASE_URL at Postgres/MySQL for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role: SUPER_ADMIN | ADMIN | REGISTRAR | STUDENT
// ApplicationStatus: PENDING | UNDER_REVIEW | ACCEPTED | REJECTED | ENROLLED
// StudentStatus: CURRENT | ALUMNI | SUSPENDED | WITHDRAWN
// PostCategory: NEWS | EVENT
//
// These are modeled as plain strings (not Prisma enums) because the default SQLite
// connector doesn't support native enums. If you switch to Postgres/MySQL in production,
// you can optionally convert these back to real `enum` blocks for stricter DB-level
// validation — the app code already treats them as string literal unions either way.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT")
  fullName     String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?
}

model Course {
  id          String   @id @default(cuid())
  name        String
  category    String // e.g. Health, Trades, Business, ICT, Beauty & Hospitality
  duration    String // e.g. "6 months", "1 year"
  fee         Float    @default(0)
  intake      String? // e.g. "January & July"
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  applications Application[]
  students     Student[]
    lessons      Lesson[]
}

model Application {
  id               String            @id @default(cuid())
  applicationNo    String            @unique
  fullName         String
  email            String
  phone            String
  nationalId       String
  dateOfBirth      DateTime
  gender           String
  address          String
  guardianName     String?
  guardianPhone    String?
  highestQualification String
  idDocumentUrl    String?
  transcriptUrl    String?
  courseId         String
  course           Course            @relation(fields: [courseId], references: [id])
  status           String            @default("PENDING")
  reviewNotes      String?
  submittedAt      DateTime          @default(now())
  reviewedAt       DateTime?

  student Student?
}

model Student {
  id             String        @id @default(cuid())
  studentNumber  String        @unique
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id])
  applicationId  String?       @unique
  application    Application?  @relation(fields: [applicationId], references: [id])
  fullName       String
  email          String
  phone          String
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id])
  status         String        @default("CURRENT")
  enrollmentDate DateTime      @default(now())
  graduationDate DateTime?
  createdAt      DateTime      @default(now())

  certificates Certificate[]
}

model Certificate {
  id                String   @id @default(cuid())
  certificateNo     String   @unique
  verificationCode  String   @unique
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  courseName        String
  grade             String?
  issueDate         DateTime @default(now())
  isRevoked         Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model Post {
  id        String       @id @default(cuid())
  title     String
  slug      String       @unique
  category  String
  summary   String
  content   String
  imageUrl  String?
  eventDate DateTime?
  location  String?
  published Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  description String
  website     String?
  isMinistry  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String
  category  String   @default("Campus Life") // e.g. Campus Life, Workshops, Graduation, Events
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  title       String
  description String
  quizJson    String?
  videoUrl    String?
  documentUrl String?
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model LessonProgress {
  id          String   @id @default(cuid())
  studentId   String
  lessonId    String
  completedAt DateTime @default(now())

  @@unique([studentId, lessonId])
}

model QuizResult {
  id          String   @id @default(cuid())
  studentId   String
  lessonId    String
  score       Int
  total       Int
  passed      Boolean
  attemptedAt DateTime @default(now())

  @@unique([studentId, lessonId])
}