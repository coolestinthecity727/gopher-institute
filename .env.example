# Copy this file to .env and fill in real values before running the app.

# Prisma / database. SQLite works out of the box for local development.
# For production, swap to Postgres/MySQL, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/gopher_institute"
DATABASE_URL="file:./dev.db"

# Used to sign login session tokens (JWT). Use a long random string in production.
JWT_SECRET="replace-this-with-a-long-random-string"

# Used to seed the first super-admin account (prisma/seed.js)
SEED_ADMIN_EMAIL="admin@gopherinstitute.ac.zw"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Public site URL (used in emails / certificate verification links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
